<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Every 15 min, read-only: NAV/peak, kill check, stop presence, drift, heartbeat, publishes execution records. Never places orders. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fbzz.council.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{RELEASE}}/.venv/bin/council</string><string>watch</string>
  </array>
  <key>WorkingDirectory</key><string>{{RELEASE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>COUNCIL_ROLE</key><string>runner</string>
    <key>COUNCIL_MODE</key><string>live</string>
    <key>COUNCIL_AGENT_CONTEXT</key><string>1</string>
  </dict>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{LOGS}}/watch.out.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/watch.err.log</string>
</dict>
</plist>
