<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rehearsal soak (M5-F): hourly at :40 on the rehearsal state; stub LLM except the 10:40 UTC slot (real model, once a day). No broker; publishes to state_dir/rehearsal/remote.git only. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.fbzz.council.rehearsal.cycle</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-i</string>
    <string>{{RELEASE}}/.venv/bin/python</string><string>-m</string><string>council.operator.soak</string><string>cycle</string>
  </array>
  <key>WorkingDirectory</key><string>{{RELEASE}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>{{HOME}}</string>
    <key>COUNCIL_ROLE</key><string>runner</string>
    <key>COUNCIL_MODE</key><string>dry_run</string>
    <key>COUNCIL_AGENT_CONTEXT</key><string>1</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Minute</key><integer>40</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>Nice</key><integer>5</integer>
  <key>StandardOutPath</key><string>{{LOGS}}/rehearsal-cycle.out.log</string>
  <key>StandardErrorPath</key><string>{{LOGS}}/rehearsal-cycle.err.log</string>
</dict>
</plist>
