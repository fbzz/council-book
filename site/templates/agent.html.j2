{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}{{ agent.name }}{% endblock %}
{% block toc %}
{{ m.toc_item("what", "What it does", agent.accent) }}
{{ m.toc_item("numbers", "Its numbers", "neutral") }}
{{ m.toc_item("history", "History (" ~ (agent.entries | length) ~ ")", agent.accent) }}
{% if agent.older %}{{ m.toc_item("older", "Older runs", "neutral") }}{% endif %}
{{ m.toc_group("Other agents") }}
{% for a in agents if a.slug != agent.slug %}<li><a href="{{ a.slug }}.html"><span class="dot accent-{{ a.accent }}" aria-hidden="true"></span><span class="toc-label">{{ a.name }}</span></a></li>{% endfor %}
{% endblock %}
{% block main %}
{% set s = agent.stats %}
<header class="hero hero-agent">
  <p class="eyebrow"><a href="index.html">Agents</a> / {{ agent.spec.group }}</p>
  <div class="ahead ahead-hero">
    {{ m.avatar(agent.icon, agent.accent, "lg") }}
    <div class="ahead-text">
      <h1>{{ agent.name }} <span class="node-kind kind-{{ agent.kind | lower }}">{{ agent.kind }}</span></h1>
      <p class="lede">{{ agent.job }}</p>
    </div>
  </div>
</header>

{% macro turn_block(a, href) %}
{% set b = a.body %}
{% if a.calls or a.failure %}{{ m.terminal(a.calls, a.name ~ " — " ~ plural(a.calls | length, "call"), a.meta, a.failure, "Model calls of " ~ a.name) }}{% endif %}
{{ m.failure(a.failure) }}
{% if b %}
<p class="stance">{{ "Wants to" if b.changes else "Stance:" }} <strong>{{ b.stance if not b.changes else b.stance[:1] | lower ~ b.stance[1:] }}</strong></p>
<blockquote class="argument"><p>{{ b.argument }}</p></blockquote>
{% if b.legacy_cut %}<p class="small muted legacy">Shortened when published: early runs kept only the first 600 characters of each argument; later runs publish it whole.</p>{% endif %}
{% if b.claims %}
<ol class="claims">
{% for cl in b.claims %}
  <li class="claim"><a class="cid" href="{{ href }}#{{ cl.anchor }}">{{ cl.id }}</a> {{ cl.text }}{% if cl.chips %}<span class="evs">{{ m.chips(cl.chips) }}</span>{% endif %}
  {% if cl.fates %}<ul class="fates-inline">{% for f in cl.fates %}<li>{{ m.verdict(f.verdict) }} <a href="{{ f.href }}">{{ f.who }}</a>{% if f.dagger %}<sup class="dag">†</sup>{% endif %}: {{ f.text }}</li>{% endfor %}</ul>{% endif %}
  </li>
{% endfor %}
</ol>
{% if b.daggers %}<p class="small muted footnote"><sup class="dag">†</sup> {{ how_words.inferred }}</p>{% endif %}
{% endif %}
{% if b.rebuttals %}
<p class="list-label">Answers to the bull: concedes {{ b.concede }}, contests {{ b.refute }}</p>
<ul class="rebuttals">{% for rb in b.rebuttals %}<li>{{ m.verdict(rb.verdict) }} {% if rb.target_href %}<a class="cref" href="{{ rb.target_href }}">bull's {{ rb.claim_id }}</a>{% else %}<span class="cid">{{ rb.claim_id }}</span>{% endif %}{% if rb.target_text %} <q class="muted">{{ rb.target_text }}</q>{% endif %}<br>{{ rb.text }}{% if rb.chips %}<span class="evs">{{ m.chips(rb.chips) }}</span>{% endif %}</li>{% endfor %}</ul>
{% endif %}
{% if b.concessions %}
<p class="list-label">Concedes</p>
<ul class="concessions">{% for x in b.concessions %}<li>{% if x.href %}<a class="cref" href="{{ x.href }}">bear's {{ x.ref }}</a>: {% endif %}{{ x.text }}</li>{% endfor %}</ul>
{% endif %}
{% if b.used_ok %}<p class="small muted">{% if b.used_got %}The used manager attempt did what {{ b.who }} asked here ({{ b.asked }}){% else %}The used manager attempt chose to {{ b.did }}; {{ b.who }} asked to {{ b.asked }}{% endif %} · it named {{ b.used_label or "no side" }} as its side.</p>{% endif %}
{% endif %}
{% endmacro %}

{% call m.section("what", 1, "What it does", agent.accent) %}
<p class="big">{{ agent.job }}</p>
{% if agent.more %}<p>{{ agent.more }}</p>{% endif %}
<dl class="facts facts-plain">
  <div><dt>Kind</dt><dd>{{ "a language model" if agent.kind == "LLM" else "code" }}</dd></div>
  {% if agent.kind == "LLM" %}<div><dt>Model</dt><dd><code>{{ agent.model }}</code></dd></div>{% endif %}
  {% if agent.source %}<div><dt>{{ "Prompt" if agent.kind == "LLM" else "Source" }}</dt><dd><a href="{{ agent.source }}">{{ agent.source_path }}</a></dd></div>{% endif %}
</dl>
{% if agent.prompts %}
<p class="small">Prompts in force: {% for p in agent.prompts %}<a href="{{ p.href }}">{{ p.id }}</a> <span class="n muted">{{ p.sha }}</span>{% if not loop.last %} · {% endif %}{% endfor %}. Each run records the hash of the prompts it used; a prompt change is a versioned policy change.</p>
{% endif %}
{% endcall %}

{% call m.section("numbers", 2, "Its numbers", "neutral") %}
<dl class="strip strip-agent">
  {% if agent.kind == "LLM" %}
  <div class="st st-ring"><dt>{{ icon("circle-check") }}Usable replies</dt><dd>{{ m.pring(s.ok_num, s.ok_css, (s.ok_pct ~ " of calls usable") if s.calls else "no calls yet") }}</dd><dd class="st-v st-v-sm">{{ s.ok }} <span class="st-of">of {{ s.calls }} calls</span></dd></div>
  <div class="st"><dt>{{ icon("circle-x") }}Failed calls</dt><dd class="st-v">{{ s.failed | length }}</dd><dd class="st-sub">{% if s.failed %}{{ s.fail_words | join(", ") }}{% else %}none{% endif %}{% if s.corrected %} · {{ s.corrected }} fixed by a correction{% endif %}</dd></div>
  <div class="st"><dt>{{ icon("clock-3") }}Median time</dt><dd class="st-v">{{ s.latency }}</dd><dd class="st-sub">per call</dd></div>
  {% endif %}
  <div class="st"><dt>{{ icon("list-checks") }}Runs</dt><dd class="st-v">{{ s.runs }}</dd><dd class="st-sub">{% if s.last %}last seen <a href="../cycles/{{ s.last.cv.doc.cycle_id }}.html">{{ s.last.cv.doc.slot | short_when }}</a>{% else %}not seen yet{% endif %}</dd></div>
  {% if s.got is defined %}
  <div class="st"><dt>{{ icon("briefcase") }}Manager did what it asked</dt><dd class="st-v st-v-sm">{{ s.got }}</dd><dd class="st-sub">by its final proposal · named it as its side: {{ s.named }}</dd></div>
  <div class="st"><dt>{{ icon("ban") }}Claims set aside</dt><dd class="st-v">{{ s.dismissed }}</dd><dd class="st-sub">by the used attempt</dd></div>
  {% endif %}
  {% if s.valid is defined %}
  <div class="st"><dt>{{ icon("file-check") }}Valid attempts</dt><dd class="st-v">{{ s.valid }}</dd><dd class="st-sub">after the auditor</dd></div>
  <div class="st"><dt>{{ icon("git-compare-arrows") }}Runs with a change</dt><dd class="st-v">{{ s.changed }}</dd><dd class="st-sub">away from the reference</dd></div>
  {% endif %}
  {% if s.differs is defined %}
  <div class="st"><dt>{{ icon("git-compare-arrows") }}Differs from the council</dt><dd class="st-v">{{ s.differs }}</dd><dd class="st-sub">runs</dd></div>
  {% endif %}
</dl>
{% if agent.kind == "LLM" %}
<p class="list-label">Failed calls</p>
{% if s.failed %}
<ul class="failed-calls">{% for f in s.failed %}<li><a href="{{ f.href }}">{{ f.when }}{% if f.attempt %} · attempt {{ f.attempt }}{% endif %}</a> {{ m.mark({"css": f.css, "word": f.word}) }} <span class="muted">it {{ f.what }}</span></li>{% endfor %}</ul>
{% else %}<p class="small muted">No failed call in the published runs.</p>{% endif %}
{% endif %}
{% endcall %}

{% call m.section("history", 3, "History", agent.accent) %}
{% if agent.entries %}
<p class="small muted">Newest first{% if agent.older %}; the latest {{ agent.entries | length }} runs{% endif %}. Each entry opens its place in the run.</p>
{% for e in agent.entries %}
{% set cv = e.cv %}
<article class="entry" id="run-{{ cv.doc.cycle_id }}">
  <header class="entry-head">
    <a class="entry-when" href="{{ e.href }}#{{ e.sections[0].id }}">{{ cv.doc.slot | when }} <span class="entry-open">Open in run →</span></a>
    {{ m.chip(cv.mode_chip) }} {{ m.mark(e.status) }}
  </header>
  {% if e.chain %}{{ m.chain(e.chain, e.href) }}{% endif %}
  {% for a in e.sections %}
  {% set b = a.body %}
  {% if agent.slug == "bull" %}<h4 class="entry-turn"><a href="{{ e.href }}#{{ a.id }}">{{ a.name }}</a> {{ m.mark(a.status) }}</h4>{% endif %}
  {% if agent.slug in ("bull", "bear") %}
  {{ turn_block(a, e.href) }}
  {% elif agent.slug in ("news", "macro") %}
  {{ m.terminal(a.calls, a.name ~ " — " ~ plural(a.calls | length, "call"), a.meta, a.failure, "Model calls of " ~ a.name) }}
  {{ m.failure(a.failure) }}
  {% if agent.slug == "macro" %}
    {% if b.note %}<p class="small muted">{{ b.note }}</p>{% endif %}
    {% if b.macro %}<p>Regime: <span class="chip state-{{ b.macro.css }}">{{ b.macro.regime }}</span></p><ol class="claims">{% for d in b.macro.drivers %}<li class="claim">{{ d.text }}{% if d.chips %}<span class="evs">{{ m.chips(d.chips) }}</span>{% endif %}</li>{% endfor %}</ol>{% endif %}
  {% endif %}
  {% for k in b.cards %}{{ m.kcard(k) }}{% endfor %}
  {% if agent.slug == "news" and not b.cards and not a.failure %}<p class="muted small">No cards.</p>{% endif %}
  {% elif agent.slug in ("pm", "control") %}
  {{ m.terminal(a.calls, a.name ~ " — " ~ plural(a.calls | length, "call"), a.meta, a.failure, "Model calls of " ~ a.name) }}
  {{ m.failure(a.failure) }}
  {% if agent.slug == "control" and b.control %}{{ m.control_strip(b.control) }}{% endif %}
  {% if agent.slug == "pm" %}<p>{% if b.decision %}Decision: <strong>{{ b.decision }}</strong>.{% elif b.reps %}Decision: <strong>hold the reference</strong>.{% else %}No decision: the reference applied.{% endif %} Valid attempts: {{ b.valid }} of {{ b.total }}.</p>{% endif %}
  {{ m.reps(b.reps) }}
  {% elif agent.slug == "data" %}
  <p>{{ plural(b.n_lines, "line") }} read{% if b.trends %} · trend {{ b.trends }}{% endif %}{% if b.n_facts %} · {{ plural(b.n_facts, "fact") }}{% endif %}.{% if b.stale %} <span class="warn-text">Too old: {{ b.stale | join(", ") }}.</span>{% endif %}{% if b.calendar %} <span class="warn-text">{{ b.calendar | capitalize }}.</span>{% endif %}</p>
  {% elif agent.slug == "reference" %}
  <p>Holds {{ b.held }} of {{ b.n }} lines, {{ b.gross }} of the portfolio.</p>
  {% elif agent.slug in ("vol", "event") %}
  {% for k in b.cards %}{{ m.kcard(k) }}{% else %}<p class="muted small">No card.</p>{% endfor %}
  {% if b.windows %}<p class="small">Adds blocked on {{ b.windows | join(", ") }}.</p>{% endif %}
  {% elif agent.slug == "audit" %}
  {% if b.notes %}<ul class="ticks">{% for x in b.notes %}<li>Attempt {{ x.n }} {{ x.kind }}: <span title="{{ x.raw }}">{{ x.text }}</span></li>{% endfor %}</ul>{% else %}<p class="small">Nothing reverted.</p>{% endif %}
  {% if b.clipped %}<p class="small">Clipped: {% for x in b.clipped %}{{ x.name }} {{ x.asked }} → {{ x.got }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
  {% elif agent.slug == "risk" %}
  <p>{{ a.status.word | cap }}.{% if b.held %} Held back: {% for r in b.held %}{{ r.name }} ({{ r.held | join("; ") }}){% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>
  {% elif agent.slug == "costs" %}
  <p>{% if b.legs %}{{ plural(b.legs | length, "order") }}, cost {{ cv.doc.plan.cost_bp_total | bp }} of the portfolio: {% for x in b.legs %}{{ x.leg.line | line_name }} ({{ x.why | lower }}){% if not loop.last %}; {% endif %}{% endfor %}.{% else %}No orders.{% endif %}{% if cv.rehearsal %} Rehearsal: nothing was sent.{% endif %}</p>
  {% endif %}
  {% endfor %}
</article>
{% endfor %}
{% else %}
{{ m.empty("No history yet", "This agent has not appeared in a published run.") }}
{% endif %}
{% endcall %}

{% if agent.older %}
{% call m.section("older", 4, "Older runs", "neutral") %}
<ul class="older">{% for e in agent.older %}<li><a href="{{ e.href }}#{{ e.sections[0].id }}">{{ e.cv.doc.slot | when }}</a> {{ m.mark(e.status) }}</li>{% endfor %}</ul>
{% endcall %}
{% endif %}
{% endblock %}
