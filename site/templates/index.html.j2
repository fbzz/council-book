{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}Portfolio{% endblock %}
{# the hero below carries the mode and the STALE badge, so the top bar does not repeat them #}
{% block status_chip %}{% endblock %}
{% block stale %}{% endblock %}
{% block toc %}
{{ m.toc_item("holdings", "Holdings by line", "long") }}
{{ m.toc_item("latest", "Latest council run", "pm") }}
{{ m.toc_item("recent", "Recent runs", "proposed") }}
{{ m.toc_item("performance", "Performance vs controls", "code") }}
{% endblock %}
{% block main %}
{% set target = portfolio and portfolio.basis == "target" %}
<header class="hero">
  <p class="eyebrow">Portfolio</p>
  <h1>What the council holds</h1>
  <p class="lede">A council of language models reviews a small multi-asset portfolio every four hours. Code enforces every limit, and a person approves every order.</p>
  <div class="status-row">
    <span class="chip chip-lg state-{{ status.mode_chip.css }}" title="Mode">{{ status.mode_chip.label }}</span>
    {% set k = kill_chip(status.kill) %}
    <span class="chip chip-lg state-{{ k.css }}" title="Kill switch: {{ kill_phrase }}"><span aria-hidden="true">{{ "✓ " if status.kill == "NORMAL" else "! " }}</span>kill switch: {{ k.label | lower }}</span>
    {% if status.last_when %}<span class="lastrun">Last run {{ status.last_when }}{% if status.last_late %} ({{ status.last_late }}){% endif %} · page built {{ status.built_clock }}</span>{% endif %}
    <span id="stale" class="chip chip-lg state-warn" hidden title="The last run is more than 5 hours old">! STALE</span>
  </div>
</header>

{% if latest and latest.rehearsal %}
{{ m.rehearsal_banner("These are the weights the council would hold; nothing has been traded.") }}
{% endif %}
{% if run %}
<p class="headline">{{ run.headline }} <a href="#latest">See the run ↓</a></p>
{% endif %}
{% if status.last_cycle_id and not status.last_cycle_revealed and status.last_decision %}
<p class="note-line">The run of {{ status.last_slot_when }} is sealed: {{ m.chip(status.last_decision) }}. It is revealed here once its decision is final.</p>
{% endif %}

{% if portfolio %}
{% set t = portfolio.tiles %}
<div class="tiles">
  <div class="tile">
    <p class="tile-label">Invested{% if target %} · target{% endif %}</p>
    <p class="tile-value">{{ t.invested }}</p>
    <p class="tile-sub">{{ "all long, no shorts" if t.all_long else "all positions, long and short" }}</p>
  </div>
  {% if t.all_long %}
  <div class="tile">
    <p class="tile-label">Lines held{% if target %} · target{% endif %}</p>
    <p class="tile-value">{{ t.held }} <span class="tile-of">of {{ t.n_lines }}</span></p>
    <p class="tile-sub">lines with a position</p>
  </div>
  {% else %}
  <div class="tile">
    <p class="tile-label">Net exposure{% if target %} · target{% endif %}</p>
    <p class="tile-value">{{ t.net }}</p>
    <p class="tile-sub">long minus short</p>
  </div>
  {% endif %}
  <div class="tile">
    <p class="tile-label">Cash{% if target %} · target{% endif %}</p>
    <p class="tile-value">{{ t.cash }}</p>
    <p class="tile-sub">not invested</p>
  </div>
  {% set mt = t.meter %}
  <div class="tile">
    <p class="tile-label">Fall from peak vs the {{ mt.halt_label }} stop</p>
    <p class="tile-value">{{ mt.value }}{% if mt.state == "none" %} <span class="tile-of">{{ mt.sub }}</span>{% endif %}{% if mt.word %} <span class="mark mark-{{ 'ok' if mt.state == 'ok' else 'fallback' if mt.state == 'warn' else 'failed' }} tile-mark"><span aria-hidden="true">{{ "✓" if mt.state == "ok" else "!" }}</span> {{ mt.word }}</span>{% endif %}</p>
    <div class="meter" role="img" aria-label="{{ mt.aria }}">
      <span class="meter-fill meter-{{ mt.state }} {{ mt.fill }}"></span>
      <span class="meter-tick {{ mt.warn_at }}"></span>
    </div>
    <p class="meter-scale" aria-hidden="true"><span>0</span><span>{{ mt.halt_label }}</span></p>
    <p class="tile-sub">Tick {{ mt.warn_label }}: no new risk · {{ mt.halt_label }}: stop{% if mt.state != "none" %} · {{ mt.sub }}{% endif %}</p>
  </div>
</div>
<p class="tiles-note small muted">
{% if portfolio.basis == "target" %}Target weights from the rehearsal run of {{ portfolio.when }}. Percent of the portfolio: 35% means 0.35x the portfolio's value.
{% elif portfolio.basis == "book" %}Positions after the run of {{ portfolio.when }}. Percent of the portfolio's value.
{% else %}Positions at the start of the latest run ({{ portfolio.when }}). Percent of the portfolio's value.{% endif %}
</p>
{% endif %}

{% call m.section("holdings", 1, "Holdings by line", "long") %}
{% if portfolio %}
<p>The portfolio is split into {{ portfolio.rows | length }} <strong>lines</strong>, each a market it can hold, such as the Nasdaq-100 or gold. Each bar is a line's weight{% if target %} in the target the council would hold{% endif %}, as a share of the portfolio. The thin tick marks the <strong>mechanical reference</strong>: {{ reference_gloss }}.</p>
<p class="small"><strong>Size</strong> is how much of a line's full allocation is held: 1.00 is the full amount the rules give it, 0.25 a quarter.</p>
<div class="holdings{% if portfolio.one_sided %} one-sided{% endif %}">
  <div class="hrow axis-row" aria-hidden="true">
    <div class="hname muted small">Line and trend</div>
    <div class="hbar"><div class="axis">{% for a in portfolio.axis %}<span class="tick {{ a.cls }} {{ a.at }}">{{ a.label }}</span>{% endfor %}</div></div>
  </div>
  {% for g in portfolio.groups %}
  <h3 class="hgroup">{{ g.label }} <span class="muted">· {{ g.share }}{% if target %} target{% endif %}</span></h3>
  {% if g.note %}<p class="hgnote">{{ g.note }}</p>{% endif %}
  <ul class="hrows" role="list">
  {% for r in g.rows %}
    <li class="hrow">
      <div class="hname"><strong>{{ r.name }}</strong> {{ m.trend_chip(r.trend) }}{% if r.marker %} <span class="hmark">{{ r.marker }}</span>{% endif %}</div>
      <div class="hbar">{{ m.dbar(r.bar, r.title) }}</div>
      {% for n in r.notes %}<p class="hnote">{{ n }}</p>{% endfor %}
    </li>
  {% endfor %}
  </ul>
  {% endfor %}
</div>
<ul class="legend small">
  <li><span class="swatch sw-long"></span>long{% if portfolio.one_sided %} (this book holds no shorts){% endif %}</li>
  {% if portfolio.has_short %}<li><span class="swatch sw-short"></span>short</li>{% endif %}
  <li><span class="swatch sw-ref"></span>mechanical reference</li>
  <li class="muted">Trend: the line's price trend, which sets the reference.</li>
</ul>
<details class="more">
  <summary>Show as table</summary>
  {{ m.wrap_open("Holdings by line (scrolls sideways)") }}
  <table class="wide">
    <thead><tr><th>Line</th><th>Trend</th><th class="n">Reference size</th><th class="n">Council size</th><th class="n">Weight</th><th class="n">Share</th><th class="n">Reference weight</th></tr></thead>
    <tbody>
    {% for r in portfolio.rows %}
    <tr>
      <td><strong>{{ r.name }}</strong> <span class="muted small">{{ r.line }}</span></td>
      <td>{{ r.trend or "—" }}</td>
      <td class="n">{{ r.ref_level | level }}</td>
      <td class="n">{{ r.council_level | level }}</td>
      <td class="n">{{ r.weight | x }}</td>
      <td class="n">{{ r.share }}</td>
      <td class="n">{{ r.ref | x }} ({{ r.ref_share }})</td>
    </tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="small muted">Size: how much of the line's full allocation is held (1.00 = full). Weight: a multiple of the portfolio's value (x); 0.35x is 35%.</p>
</details>
{% else %}
{{ m.empty("Nothing held yet", "No broker account is connected and the council has not run. After the first run, each line's weight appears here.") }}
<p class="small muted">The lines it will hold: {% for l in lines %}<span class="chip line-chip">{{ l.name }}</span>{% endfor %}</p>
{% endif %}
{% endcall %}

{% call m.section("latest", 2, "Latest council run", "pm") %}
{% if latest %}
<div class="run-head">
  <p class="run-when">{{ run.when }}</p>
  {{ m.chip(latest.mode_chip) }} {{ m.chip(latest.chip) }}
</div>
{{ m.story(run.summary) }}
{{ m.flow(run.nodes, "The latest run, step by step") }}
{{ m.flow_key(run.nodes) }}
{{ m.control_strip(run.control) }}
<p><a class="cta" href="cycles/{{ latest.doc.cycle_id }}.html">Open the full run →</a></p>
{% else %}
<p>No run yet. When the council first meets, this diagram fills in with what each step did.</p>
{{ m.flow(flow_empty, "The steps of a run") }}
{{ m.flow_key(flow_empty) }}
<p class="small"><a href="how.html">How it works →</a></p>
{% endif %}
{% endcall %}

{% call m.section("recent", 3, "Recent runs", "proposed") %}
{% if recent %}
{{ m.wrap_open("Recent runs") }}
<table class="wide stack runs" role="table">
  <thead><tr role="row"><th role="columnheader">When</th><th role="columnheader">Mode</th><th role="columnheader">What changed</th><th role="columnheader">Decision</th></tr></thead>
  <tbody>
  {% for cv, r in recent %}
  <tr role="row">
    <td role="cell" class="when"><a href="cycles/{{ cv.doc.cycle_id }}.html">{{ cv.doc.slot | when }}</a></td>
    <td role="cell" data-label="Mode">{{ m.chip(cv.mode_chip) }}</td>
    <td role="cell" class="text push" data-label="What changed">{{ r.change_words }}</td>
    <td role="cell" data-label="Decision">{{ m.chip(cv.chip) }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p><a href="cycles.html">All runs →</a></p>
{% else %}
{{ m.empty("No runs yet", "The first run will appear here, with what changed and what was decided.") }}
{% endif %}
{% endcall %}

{% call m.section("performance", 4, "Performance vs controls", "code") %}
{% if chart %}
<figure class="chart">
  <svg viewBox="0 0 {{ chart.width }} {{ chart.height }}" role="img" aria-label="Index of the book and its controls, base 100 at the start">
    {% for g in chart.grid %}
    <line class="{{ 'chart-base' if g.base else 'chart-grid' }}" x1="{{ chart.x0 }}" x2="{{ chart.x1 }}" y1="{{ g.y }}" y2="{{ g.y }}"></line>
    <text class="chart-tick" x="{{ chart.x0 - 6 }}" y="{{ g.y }}" text-anchor="end" dominant-baseline="middle">{{ g.label }}</text>
    {% endfor %}
    {% for s in chart.series %}
    <polyline class="series series-{{ s.css }}" points="{{ s.points }}"><title>{{ s.label }}: {{ "%.1f" | format(s.last) }}</title></polyline>
    <text class="series-end" x="{{ s.end_x }}" y="{{ s.label_y }}" dominant-baseline="middle">{{ s.short }} {{ "%.1f" | format(s.last) }}</text>
    {% endfor %}
  </svg>
  <figcaption class="small">Index, base 100 at the start ({{ chart.first }} to {{ chart.last }}). The darker line is 100.</figcaption>
</figure>
<ul class="legend">
{% for s in chart.series %}<li><span class="swatch sw-line sw-{{ s.css }}"></span>{{ s.label }} <span class="n">{{ "%.1f" | format(s.last) }}</span></li>{% endfor %}
</ul>
<details class="more">
  <summary>Show as table</summary>
  {{ m.wrap_open("Performance by day (scrolls sideways)") }}
  <table class="wide">
    <thead><tr><th>Day</th>{% for key, label, css, short, what in controls %}<th class="n">{{ label }}</th>{% endfor %}<th class="n">Fall from peak</th></tr></thead>
    <tbody>
    {% for p in points %}
    <tr><td class="n">{{ p.as_of | day }}</td>{% for key, label, css, short, what in controls %}<td class="n">{% set v = p[key] %}{{ "%.1f" | format(v) if v is not none else "—" }}</td>{% endfor %}<td class="n">{{ p.drawdown_pct | pct }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
</details>
<dl class="defs">
  {% for key, label, css, short, what in controls %}<dt><span class="swatch sw-line sw-{{ css }}"></span>{{ label }}</dt><dd>{{ what }}</dd>{% endfor %}
</dl>
<p class="small muted">Descriptive only. Differences over months are mostly noise; see <a href="how.html#never">what this can never prove</a>.</p>
{% else %}
{{ m.empty("No performance data yet", "The index starts with the first executed run. Rehearsal runs never count: nothing was traded.") }}
{% endif %}
{% endcall %}
{% endblock %}
