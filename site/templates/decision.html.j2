{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% import "paper_macros.html.j2" as pm %}
{% set doc = d.doc %}
{% set sw = d.sw %}
{% set bn = d.banner %}
{% block title %}Decision #{{ doc.decision_no }}{% endblock %}
{% block status_chip %}<span class="chip state-rehearsal" title="A paper run: real data and models, no broker connected, nothing traded">PAPER · NO BROKER</span>{% endblock %}
{% block toc %}
{{ m.toc_item("d-verdict", "The verdict", "pm") }}
{% if sw %}{{ m.toc_item("d-ideas", "Every idea's journey", "scout") }}{% endif %}
{{ m.toc_item("d-core", "Core council", "macro") }}
{% if sw %}{{ m.toc_item("d-inputs", "Inputs", "news") }}{% endif %}
{% if book %}{{ m.toc_item("d-book", "The book after this decision", "pm") }}{% endif %}
{% endblock %}
{% block hero %}
<header class="hero">
  <p class="eyebrow">{{ pm.badge() }} <a href="../index.html">Decisions</a> / #{{ doc.decision_no }} · {{ doc.slot | when }}{% if d.run_href %} · <a href="{{ root }}{{ d.run_href }}">run page</a>{% endif %}</p>
  <h1>Decision #{{ doc.decision_no }}: {{ "entered " ~ (d.chosen | length) ~ " paper trade(s)" if d.chosen else "no swing trade" }}</h1>
  <p class="lede">A paper run: real data and the real agents, nothing traded, no approval. Published at once through the same public pipeline as a live run (allow-listed fields, licensed news by id only, percent-only).{% if d.verified %} <span class="chip state-executed"><span aria-hidden="true">✓ </span>VERIFIED</span> the file re-hashes to its commitment.{% endif %}</p>
  <aside class="disclaimer" role="note" aria-label="About this record">
    <p><strong>Paper record, not advice.</strong> No money was traded; this is a public log of what an experimental council of language-model agents decided, for transparency. Sizes are percentages of a paper portfolio only.</p>
    <p><span class="redacted">redacted</span> marks a figure or quote the public record may not carry: market data we license for the agents' own use (prices, moves, volume, short interest) and licensed news text. The agents saw the full values; the code-derived buckets next to them (for example "reaction: strongly against") summarise them.</p>
  </aside>
</header>
{% endblock %}
{% block main %}

<section class="card accent-pm vb" id="d-verdict" aria-labelledby="d-verdict-h">
  <h2 id="d-verdict-h" class="vb-title">{% if bn.entered %}Entered: {% for j in bn.entered %}<span class="tkr">{{ j.i.ticker | ticker }}</span> {{ j.i.side }}{% if j.leg %} {{ j.leg.size }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}No trade{% endif %}</h2>
  {% if bn.closest %}{% set c = bn.closest %}
  <p class="vb-closest">Closest to trading: <a href="#{{ c.anchor }}" class="tkr">{{ c.i.ticker | ticker }}</a> {{ pm.side(c.i.side) }} — stopped at <strong>{{ c.stop_label }}</strong> ({{ c.reason }}){% if c.votes and c.stop >= 4 %}, after the manager voted {{ c.votes[0] }} of {{ c.votes[1] }} to enter{% endif %}.</p>
  {% elif sw and not d.journeys %}<p class="vb-closest">The Scout pitched no swing idea this slot.</p>{% endif %}
  <dl class="vb-rows">
    <div><dt><span class="dot accent-macro" aria-hidden="true"></span>Core</dt><dd>{{ d.core_line.verb | cap }}{% if d.core_line.weights %}: {% for w in d.core_line.weights %}<span class="tkr">{{ w.line | ticker }}</span> <strong class="n">{{ w.w }}</strong>{% if not loop.last %} · {% endif %}{% endfor %}{% if d.core_line.more %} · {{ d.core_line.more }} more{% endif %}{% endif %}</dd></div>
    {% if bn.budget %}<div><dt><span class="dot accent-pm" aria-hidden="true"></span>Swing budget</dt><dd><strong class="n">{{ bn.budget.swing }}</strong> swing / <strong class="n">{{ bn.budget.core }}</strong> core, set by the council ({{ plural(bn.budget.votes, "valid vote") }}){% if bn.budget.fallback %}; no usable vote, so the last budget was kept{% endif %}. Idle swing money is invested in the core.</dd></div>{% endif %}
  </dl>
  <p class="small muted">Sizes are shares of the paper portfolio; swing results are after a declared cost of {{ "%g" | format(sw.declared_cost_pct_per_leg if sw else 1.25) }}% per leg, never the actual one.</p>
</section>

{% if sw %}
{% call m.section("d-ideas", 1, "Every idea's journey", "scout") %}
<p class="small">Each idea the Scout pitched, furthest first, through the six steps: <span class="nowrap"><span class="dot accent-scout" aria-hidden="true"></span>Scout</span> → <span class="nowrap"><span class="dot accent-risk" aria-hidden="true"></span>code gate</span> → <span class="nowrap"><span class="dot accent-skeptic" aria-hidden="true"></span>Skeptic</span> (blind to the pitch{% if sw.skeptic_model_family %}, {{ sw.skeptic_model_family }} model family{% endif %}) → <span class="nowrap"><span class="dot accent-bull" aria-hidden="true"></span>bull and <span class="dot accent-bear" aria-hidden="true"></span>bear</span> → <span class="nowrap"><span class="dot accent-pm" aria-hidden="true"></span>manager</span> (two of three attempts must enter) → <span class="nowrap"><span class="dot accent-risk" aria-hidden="true"></span>swing rules</span>. ✓ passed · ✗ stopped here · — not reached. Open a step for what that agent said.</p>
{% if d.journeys %}
{% for j in d.journeys %}{{ pm.journey(j, "../../") }}{% endfor %}
{% else %}{{ m.empty("The Scout pitched no idea", "Nothing on the reading list or the screen made a swing idea this slot.") }}{% endif %}
{% if sw.scout_passed %}<p class="small">The Scout looked at and passed on: {% for t in sw.scout_passed %}<span class="tkr">{{ t | ticker }}</span>{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
{% if sw.trace_all %}<p class="small muted">This run traced every idea through every stage, so later steps also ran for ideas the real pipeline had stopped (marked "traced only"); {{ d.differ }} idea(s) would have ended elsewhere.{% if sw.real_budget_flags %} The real slot's call budget would have applied: {{ sw.real_budget_flags | join(", ") }}.{% endif %}</p>{% endif %}
{% endcall %}
{% endif %}

{% call m.section("d-core", 2 if sw else 1, "Core council", "macro") %}
{% set co = d.core %}
<details class="jd accent-macro">
  <summary><span class="dot accent-macro" aria-hidden="true"></span><strong>{{ d.core_line.verb | cap }}</strong> <span class="jd-sum">basis {{ co.basis }} · {{ plural(co.moved, "line") }} re-weighted{% if co.macro %} · macro regime {{ co.macro }}{% endif %} · {{ plural(co.valid, "valid manager attempt") }}</span></summary>
  <div class="jd-body">
  {% if co.moves %}
  {{ m.wrap_open("Core weights") }}
  <table class="wide"><thead><tr><th>Line</th><th class="n">Before</th><th class="n">Manager proposed</th><th class="n">Final, after the risk engine</th></tr></thead><tbody>
  {% for mv in co.moves %}<tr{% if mv.moved %} class="paper-diff"{% endif %}><td>{{ mv.line | ticker }}</td><td class="n">{{ mv.before }}</td><td class="n">{{ mv.proposed }}</td><td class="n">{{ mv.after }}</td></tr>{% endfor %}
  </tbody></table></div>
  {% endif %}
  {% if co.holds %}<h3 class="small">Held by the risk engine</h3><ul class="jd-list">{% for h in co.holds %}<li>{% if h.line %}<span class="tkr">{{ h.line | ticker }}</span>: {% endif %}{{ h.text }} {{ rule_link(h.raw.split(": ", 1)[-1].split(" ")[0], root) }}</li>{% endfor %}</ul>{% endif %}
  {% if co.reps %}<h3 class="small">Manager attempts</h3><ul class="jd-list">{% for r in co.reps %}<li><span class="dot accent-pm" aria-hidden="true"></span>#{{ r.n + 1 }}: {{ "valid" if r.valid else "invalid" }} · sided with {{ r.sided }}{% if r.fact %}<br><span class="jd-k">Decisive fact</span> {{ r.fact }}{% endif %}{% for dv in r.devs %}<br>{{ dv }}{% endfor %}{% if r.why %}<br>{{ r.why }}{% endif %}</li>{% endfor %}</ul>{% endif %}
  {% if co.bull or co.bear %}<div class="paper-cols">
    <div class="paper-case accent-bull"><p><span class="dot accent-bull" aria-hidden="true"></span><strong>Bull</strong></p><p class="text small">{{ co.bull or "—" }}</p></div>
    <div class="paper-case accent-bear"><p><span class="dot accent-bear" aria-hidden="true"></span><strong>Bear</strong></p><p class="text small">{{ co.bear or "—" }}</p></div>
  </div>{% endif %}
  <p class="small">{{ plural(co.cards, "analyst card") | cap }}.</p>
  </div>
</details>
<p class="small"><a href="../../journal/paper/cycles/{{ doc.cycle_id[0:4] }}/{{ doc.cycle_id[5:7] }}/{{ doc.cycle_id }}.json">The sealed record (JSON)</a>{% if d.run_href %} · <a href="{{ root }}{{ d.run_href }}">the full run page</a>{% endif %} · <a href="../index.html">every decision</a> · <a href="{{ root }}cycles.html">every meeting</a> · <a href="{{ root }}agents/pm.html">the manager's page</a> · <a href="{{ root }}rules.html#p-core">the core rules</a></p>
{% endcall %}

{% if sw %}
{% call m.section("d-inputs", 3, "Inputs", "news") %}
{% set inp = d.inputs %}
<p>{{ plural(inp.total, "item") | cap }} on the reading list{% if inp.counts %}: {% for k, n in inp.counts %}{{ n }} {{ k }}{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}. {{ inp.licensed }} licensed headline(s) shown by id and source only; {{ inp.cited }} item(s) cited by an agent, listed first.</p>
<details class="jd accent-news">
  <summary><span class="dot accent-news" aria-hidden="true"></span><strong>The full reading list</strong> <span class="jd-sum">{{ inp.total }} item(s)</span></summary>
  <div class="jd-body">
  {% if d.reading %}
  {{ m.wrap_open("Reading list") }}
  <table class="wide"><thead><tr><th>Item</th><th>Source</th><th class="n">Age</th><th>Tickers</th></tr></thead><tbody>
  {% for r in d.reading %}<tr><td class="text">{% if r.cited %}<span class="chip tag" title="An agent cited this item">cited</span> {% endif %}{% if r.licensed %}<span title="{{ r.id }}">licensed headline</span> <span class="small muted tkr">{{ r.id }}</span>{% elif r.href %}<a href="{{ r.href }}">{{ r.label }}</a>{% else %}{{ r.label }}{% endif %}</td><td class="small">{{ r.source or "—" }}</td><td class="n">{{ r.age }}</td><td>{{ r.tickers }}</td></tr>{% endfor %}
  </tbody></table></div>
  <p class="small muted">Licensed headlines (RSS and the broker's feed) are shown by id and source only; public-domain items (SEC, Federal Reserve, BLS, …) with their title and link.</p>
  {% else %}<p class="muted small">Nothing on the reading list.</p>{% endif %}
  </div>
</details>
<details class="jd accent-news">
  <summary><span class="dot accent-news" aria-hidden="true"></span><strong>Movers screen and market context</strong> <span class="jd-sum">{{ sw.inputs.screen | length }} mover(s) · {{ sw.inputs.context | length }} context row(s)</span></summary>
  <div class="jd-body">
  {% if sw.inputs.screen %}
  {{ m.wrap_open("Movers screen") }}
  <table class="wide"><thead><tr><th>Ticker</th><th>Last day's move</th><th>Volume vs normal</th><th>Sector</th></tr></thead><tbody>
  {% for r in sw.inputs.screen %}<tr><td title="{{ r.id }}">{{ (r.ticker or "—") | ticker }}</td><td>{{ move_words(r.move) }}</td><td>{{ (r.volume ~ "×") if r.volume else "—" }}</td><td>{{ r.sector or "—" }}</td></tr>{% endfor %}
  </tbody></table></div>
  <p class="small muted">The screen is built from licensed market data: moves are shown as bands of the stock's normal daily move (σ), never the figure.</p>
  {% else %}<p class="muted small">No mover passed the screen.</p>{% endif %}
  {% if sw.inputs.context %}<ul class="jd-list small">{% for c in sw.inputs.context %}<li title="{{ c.id }}">{{ c.text }}</li>{% endfor %}</ul>{% endif %}
  {% if sw.inputs.open_trades %}<h3 class="small">Open paper swing trades the agents saw</h3>
  <ul class="jd-list small">{% for t in sw.inputs.open_trades %}<li><span class="tkr">{{ t.ticker | ticker }}</span> {{ pm.side(t.side) }} · {{ t.days_held }} day(s) · to stop {{ "—" if t.to_stop_pct is none else ("%g%%" | format(t.to_stop_pct)) }} · to target {{ "—" if t.to_target_pct is none else ("%g%%" | format(t.to_target_pct)) }}</li>{% endfor %}</ul>{% endif %}
  {% if sw.inputs.carried %}<p class="small">Carried from an earlier slot (day-2 confirmation): {{ sw.inputs.carried | join(", ") }}.</p>{% endif %}
  </div>
</details>
{% endcall %}
{% endif %}

{% if book %}
<section class="card accent-pm paper-panel" id="d-book" aria-label="The book after this decision">
{{ pm.book(book, "../../", "The book after this decision") }}
</section>
{% endif %}
{% endblock %}
