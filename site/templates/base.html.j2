<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ csp }}">
<meta name="referrer" content="no-referrer">
<meta name="color-scheme" content="light dark">
<meta name="description" content="An LLM agent council proposes trades every four hours; code enforces the risk limits and a human approves every order. The public record.">
<title>{% block title %}council-book{% endblock %} · council-book</title>
<link rel="stylesheet" href="{{ root }}static/style.css">
<link rel="stylesheet" href="{{ root }}static/geometry.css">
</head>
<body class="page-{{ page }}" data-last-cycle="{{ status.last_cycle_at }}">
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="top-inner">
    <a class="brand" href="{{ root }}index.html"><span class="brand-mark" aria-hidden="true"></span>council-book</a>
    <nav class="pages" aria-label="Pages">
    {% for p in nav %}
      <a href="{{ root }}{{ p.href }}"{% if p.key == page %} aria-current="page"{% endif %}>{{ p.label }}</a>
    {% endfor %}
    </nav>
    <div class="status-chips">
      {% block status_chip %}<span class="chip state-{{ status.css }}" title="Project status">{{ status.label }}</span>{% endblock %}
      {% block stale %}<span id="stale" class="chip state-warn" hidden title="The last run is more than 5 hours old">! STALE</span>{% endblock %}
    </div>
  </div>
</header>
<div class="layout">
  <nav class="toc" aria-label="On this page">
    <p class="toc-title">On this page</p>
    <ol>
    {% block toc %}{% endblock %}
    </ol>
  </nav>
  <main id="main">
  {% block main %}{% endblock %}
  </main>
</div>
<footer class="foot">
  <div class="foot-inner">
    <ul class="foot-list">
      <li>Not investment advice.</li>
      {% if status.prelive %}
      <li>No money is at risk yet: {{ "this is a rehearsal with no broker account" if status.mode == "rehearsal" else "no broker account is connected" }}. Once live, real money is at risk and the author holds the positions shown.</li>
      {% else %}
      <li>Real money is at risk; the author holds the positions shown.</li>
      {% endif %}
      <li>Model output may contain hallucinated or outdated facts.</li>
      <li>Backtests are illustrative and lie inside the models' training window.</li>
      <li>Not endorsed by the broker.</li>
    </ul>
    <p class="muted">Code: Apache-2.0 · Journal, docs and site text: CC BY 4.0 (excluding third-party material). Page built {{ status.built }}. <a href="{{ root }}record.html#disclaimer">All disclaimers</a>.</p>
  </div>
</footer>
<script>{{ stale_script }}</script>
</body>
</html>
