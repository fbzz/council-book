{% extends "base.html.j2" %}
{% import "macros.html.j2" as m %}
{% block title %}Run {{ run.when }}{% endblock %}
{% block toc %}
{{ m.toc_item("glance", "At a glance", "neutral") }}
{{ m.toc_item("changed", "What changed", "neutral") }}
{% for group, members in tr.groups %}
{{ m.toc_group(group) }}
{% for a in members %}{{ m.toc_item(a.id, a.name, a.accent, a.status) }}{% endfor %}
{% endfor %}
{{ m.toc_group("Outcome") }}
{{ m.toc_item("a-decision", "Human approval" ~ (" and execution" if cv.execution else ""), "human", tr.decision_status) }}
{{ m.toc_item("facts", "Facts the council saw", "neutral") }}
{{ m.toc_item("seal", "Seal and call log", "neutral") }}
{% endblock %}
{% block toc_foot %}{{ m.toc_legend() }}{% endblock %}
{% block main %}
{% set ns = namespace(n=0) %}

{# ------------------------------------------------------------------ shared pieces #}
{% macro subhead(kind, text) %}<h3 class="sub sub-{{ kind }}">{{ text }}</h3>{% endmacro %}


{% macro agent_head(a) %}
<header class="ahead">
  {{ m.avatar(a.icon, a.accent) }}
  <div class="ahead-text">
    <h2 id="{{ a.id }}-h"><span class="num" aria-hidden="true">{{ ns.n }}</span><span class="h-name">{{ a.name }}</span> <span class="node-kind kind-{{ a.kind | lower }}">{{ a.kind }}</span></h2>
    <p class="job">{{ a.job }} <a class="small" href="../{{ a.page }}">Its record across runs →</a></p>
  </div>
  <p class="h-status">{{ m.mark(a.status) }}</p>
  <a class="to-toc" href="#toc">↑ Contents</a>
</header>
{% if a.kind == "LLM" %}{{ m.terminal(a.calls, a.name ~ " — " ~ plural(a.calls | length, "call"), a.meta, a.failure, "Model calls of " ~ a.name) }}{% endif %}
{{ m.failure(a.failure) }}
{% endmacro %}


{% macro advocate(a) %}
{% set b = a.body %}
{% set turn = a.turn %}
{{ subhead("saw", "What it saw") }}
{% if turn == "bull_open" %}
<p>The fact pack, the analysts' and officers' cards and the allowed range of each line. It speaks first, so it answers no one.</p>
{% elif turn == "bear" %}
<p>Everything the bull saw, plus <a href="#a-bull">the bull's opening</a>{% if c.debate.bull %} and its {{ plural(c.debate.bull.claims | length, "claim") }}, which it must answer one by one{% else %} — which failed, so it had no claims to answer{% endif %}.</p>
{% else %}
<p>Everything above, plus <a href="#a-bear">the bear's answer</a>{% if c.debate.bear %}: {{ plural(c.debate.bear.claims | length, "claim") }} of its own and its verdicts on the bull's claims{% endif %}.</p>
{% endif %}
{% if b %}
{{ subhead("said", "What it said") }}
<p class="stance">{{ "Wants to" if b.changes else "Stance:" }} <strong>{{ b.stance if not b.changes else b.stance[:1] | lower ~ b.stance[1:] }}</strong></p>
<blockquote class="argument"><p>{{ b.argument }}</p></blockquote>
{% if b.legacy_cut %}<p class="small muted legacy">Shortened when published: early runs kept only the first 600 characters of each argument; later runs publish it whole.</p>{% endif %}
{% if b.claims %}
<p class="list-label">{{ plural(b.claims | length, "claim") }}{% if turn == "bull_open" %} (the bear must answer each){% endif %}</p>
<ol class="claims">
{% for cl in b.claims %}
  <li class="claim" id="{{ cl.anchor }}"><span class="cid">{{ cl.id }}</span> {{ cl.text }}{% if cl.chips %}<span class="evs">{{ m.chips(cl.chips) }}</span>{% endif %}</li>
{% endfor %}
</ol>
{% endif %}
{% if b.rebuttals %}
<p class="list-label">Answers to the bull's claims: concedes {{ b.concede }}, contests {{ b.refute }}</p>
<ul class="rebuttals">
{% for rb in b.rebuttals %}
  <li id="{{ rb.anchor }}">{{ m.verdict(rb.verdict) }} {% if rb.target_href %}<a class="cref" href="{{ rb.target_href }}">bull's {{ rb.claim_id }}</a>{% else %}<span class="cid">{{ rb.claim_id }}</span>{% endif %}{% if rb.target_text %} <q class="muted">{{ rb.target_text }}</q>{% endif %}<br>{{ rb.text }}{% if rb.chips %}<span class="evs">{{ m.chips(rb.chips) }}</span>{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
{% if b.concessions %}
<p class="list-label">Concedes</p>
<ul class="concessions">{% for x in b.concessions %}<li>{% if x.href %}<a class="cref" href="{{ x.href }}">bear's {{ x.ref }}</a>: {% endif %}{{ x.text }}</li>{% endfor %}</ul>
{% endif %}
{% if b.strongest %}<p class="small">Strongest fact against its own case: {{ m.ev_chip(b.strongest) }}</p>{% endif %}
{{ subhead("then", "What happened to it") }}
{% if not b.used_ok %}
<p>No valid manager attempt was used, so every line followed the mechanical reference.</p>
{% elif b.used_got %}
<p><span class="chip verdict v-used">did what it asked</span> The used attempt did what {{ b.who }} asked ({{ b.asked }}){% if b.used_sided %}, and named {{ b.who }} as the side it took.{% else %}; the manager labelled its side “{{ b.used_label }}”.{% endif %}</p>
{% else %}
<p><span class="chip verdict v-other">did something else</span> {{ b.who | cap }} asked to {{ b.asked }}; the used attempt chose to {{ b.did }}{% if b.used_sided %}, while naming {{ b.who }} as its side{% endif %}.</p>
{% endif %}
{% if b.valid %}<p class="small muted">Valid attempts that did what it asked: {{ b.got }} of {{ b.valid }} · that named it as their side: {{ b.sided }}.</p>{% endif %}
{% if b.claims %}
<ul class="fates">
{% for cl in b.claims %}
  <li><a class="cref" href="#{{ cl.anchor }}">{{ cl.id }}</a> <span class="muted">{{ cl.short }}</span>
  {% if cl.fates %}<ul>{% for f in cl.fates %}<li>{{ m.verdict(f.verdict) }} <a href="{{ f.href }}">{{ f.who }}</a>{% if f.dagger %}<sup class="dag">†</sup>{% endif %}: {{ f.text }}</li>{% endfor %}</ul>
  {% else %}<ul><li class="muted">Not answered, used or set aside by anyone.</li></ul>{% endif %}</li>
{% endfor %}
</ul>
{% if b.daggers %}<p class="small muted footnote"><sup class="dag">†</sup> {{ how_words.inferred }}</p>{% endif %}
{% endif %}
{% endif %}
{% endmacro %}


{# A code officer's own content: in full when something needs attention, else only what other
   sections link to (its cards, the reference table). #}
{% macro officer_body(a) %}
{% set b = a.body %}
{% if a.slug == "data" %}
{% if not a.compact %}
{{ subhead("saw", "What it saw") }}
<p>Completed daily bars for every line, public macro series and the calendar of scheduled events, each stamped with the time it became available. Only facts available at the slot start count.</p>
{{ subhead("did", "What it did") }}
<ul class="ticks">
  <li>Read <strong>{{ plural(b.n_lines, "line") }}</strong>{% if b.trends %}; trend {{ b.trends }}{% endif %}.</li>
  {% if b.n_facts %}<li>Built <strong>{{ plural(b.n_facts, "fact") }}</strong> for the council: {% for k, n in b.kinds %}{{ n }} {{ (k | lower)[:-1] if n == 1 and k.endswith("s") else k | lower }}{% if not loop.last %}, {% endif %}{% endfor %}. <a href="#facts">The facts table →</a></li>{% endif %}
  {% if b.stale %}<li class="warn-text"><span aria-hidden="true">! </span>Data too old, frozen: {{ b.stale | join(", ") }}.</li>{% endif %}
  {% if b.closed %}<li>Market closed: {{ b.closed | join(", ") }}.</li>{% endif %}
  {% if b.calendar %}<li class="warn-text"><span aria-hidden="true">! </span>{{ b.calendar | capitalize }}.</li>{% endif %}
</ul>
{% elif b.n_facts %}<p class="officer-more small"><a href="#facts">The facts table →</a>{% if b.closed %} · market closed: {{ b.closed | join(", ") }}{% endif %}</p>{% endif %}

{% elif a.slug == "reference" %}
{% if not a.compact %}<p>No reference book this run: every line was held as it was.</p>{% endif %}
{% if b.rows %}
<details class="more">
  <summary>The reference for every line ({{ b.n }})</summary>
  {{ m.wrap_open("The reference by line (scrolls sideways)") }}
  <table class="wide">
    <thead><tr><th>Line</th><th>Trend</th><th class="n">1 day</th><th class="n">Size</th><th class="n">Weight</th></tr></thead>
    <tbody>
    {% for r in b.rows %}<tr><td><strong>{{ r.name }}</strong> <span class="muted small">{{ r.ticker }}</span></td><td>{{ m.trend_chip(r.trend) }}</td><td class="n">{{ m.move(r.day, r.day_dir) }}</td><td class="n">{{ r.level }}</td><td class="n">{{ r.weight }}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
  <p class="small muted">It is the default position, the centre of each line's allowed range and the fallback when the council fails. The council may move at most {{ max_deviations }} lines away from it.</p>
</details>
{% endif %}

{% elif a.slug == "vol" %}
{% for k in b.cards %}{{ m.kcard(k) }}{% endfor %}
{% if b.breaker and not b.breaker.passed %}<p class="small">Volatility breaker: {{ m.mark({"css": "failed", "glyph": "✗", "word": "tripped: no risk added"}) }} <span class="muted">(value {{ b.breaker.value | value }}, limit {{ b.breaker.limit | value }})</span></p>{% endif %}
{% if b.cards %}<p class="small muted">A volatility card is one of the two kinds of card that allow the council to cut a line in an uptrend (a <em>qualifying</em> card).</p>{% endif %}

{% elif a.slug == "event" %}
{% if not a.compact %}<p>The public calendar of scheduled macro releases (Fed decisions, inflation, jobs){% if b.calendar %} — incomplete this run{% endif %}.</p>{% endif %}
{% for k in b.cards %}{{ m.kcard(k) }}{% endfor %}
{% if b.calendar %}<p class="small warn-text"><span aria-hidden="true">! </span>{{ b.calendar | capitalize }}.</p>{% endif %}
{% endif %}
{% endmacro %}

{# ------------------------------------------------------------------ the page #}
<header class="hero">
  <p class="eyebrow"><a href="../cycles.html">Runs</a> / <span class="n">{{ c.cycle_id }}</span></p>
  <h1>Council run · {{ run.when }}</h1>
  <p class="lede">Every agent in the order it ran: what it saw, what it said, and what happened to it.</p>
</header>
{% set t = tr.totals %}
{% call m.alert("run", "terminal", "Run " ~ c.cycle_id, cv.ran_at | short_when) %}
<p class="status-row">
  {{ m.chip(cv.mode_chip) }}
  {{ m.chip(cv.chip) }}
  {% if c.basis and c.basis != "council" %}<span class="chip state-sealed" title="{{ c.basis }}">basis: {{ basis_words(c.basis) }}</span>{% endif %}
  <span class="chip state-{{ kill_chip(c.kill_state).css }}">kill switch: {{ kill_chip(c.kill_state).label | lower }}</span>
  {% if cv.verified %}<span class="chip state-executed" title="The revealed file re-hashes to the commitment published before any decision"><span aria-hidden="true">✓ </span>SEAL VERIFIED</span>{% endif %}
  {% if tr.failed_calls %}<a class="chip state-warn" href="#calls"><span aria-hidden="true">! </span>{{ plural(tr.failed_calls, "call") }} failed</a>{% endif %}
</p>
<p>This run {{ run.status_words }}. {% if run.why %}Why it met: {{ run.why | join(", ") }}.{% else %}A scheduled review.{% endif %} Model <code>{{ c.model }}</code>, thinking {{ "on" if c.think else "off" }}.</p>
{% endcall %}
<dl class="strip strip-run">
  <div class="st st-ring"><dt>{{ icon("terminal") }}Model calls</dt><dd>{{ m.pring(t.ok_pct, ring_css(t.ok_pct), (t.ok ~ " of " ~ t.calls ~ " calls usable") if t.calls else "no calls") }}</dd><dd class="st-v st-v-sm">{{ t.ok }} <span class="st-of">of {{ t.calls }} ok</span></dd></div>
  <div class="st"><dt>{{ icon("activity") }}Tokens</dt><dd class="st-v st-v-sm">{{ t.tokens_in }} <span class="st-of">in</span></dd><dd class="st-sub">{{ t.tokens_out }} out</dd></div>
  <div class="st"><dt>{{ icon("clock-3") }}Model time</dt><dd class="st-v st-v-sm">{{ t.model_time }}</dd><dd class="st-sub">all calls added up</dd></div>
  <div class="st"><dt>{{ icon("shield-check") }}Risk checks</dt><dd class="st-v st-v-sm">{% if c.risk %}{{ run.checks_passed }} <span class="st-of">of {{ run.checks_total }}</span>{% else %}—{% endif %}</dd><dd class="st-sub">{% if c.risk %}{{ "all passed" if run.checks_passed == run.checks_total else "limits applied" }}{% else %}did not run{% endif %}</dd></div>
  {% set agree_n = cv.min_agreement_pct %}
  <div class="st st-ring"><dt>{{ icon("users") }}Manager agreement</dt><dd>{{ m.pring(agree_n, "ok" if agree_n is not none and agree_n >= 99.5 else ring_css(agree_n) if agree_n is not none else "idle", ("Lowest agreement " ~ run.agreement_words) if agree_n is not none else "no agreement measured", run.agreement_words if agree_n is not none else "—") }}</dd><dd class="st-sub">{% if agree_n is none %}no valid attempts{% elif agree_n >= 99.5 %}valid attempts made the same call on every line{% else %}valid attempts made the same call, on the line they agreed on least{% endif %}</dd></div>
</dl>
{{ m.fail_alert(tr) }}
{% if cv.rehearsal %}
{{ m.rehearsal_banner("The council ran on real market data, but nothing was traded and no one needed to approve anything.") }}
{% endif %}

{% set ns.n = ns.n + 1 %}
{% call m.section("glance", ns.n, "At a glance", "neutral") %}
{{ m.story(run.summary + ([tr.fail_sentence] if tr.fail_sentence else [])) }}
{{ m.flow(run.nodes, "This run, step by step", href="") }}
{{ m.flow_key(run.nodes, linked=true) }}
{{ m.control_strip(run.control) }}
{% if run.shorthand %}
<details class="more shorthand">
  <summary>Shorthand the agents use</summary>
  <dl class="defs defs-inline">
  {% for d in run.shorthand %}<div><dt>{{ d.term }}</dt><dd>{{ d.meaning }}</dd></div>{% endfor %}
  </dl>
</details>
{% endif %}
{% endcall %}

{% set ns.n = ns.n + 1 %}
{% call m.section("changed", ns.n, "What changed", "neutral") %}
<p>Every line starts from the <strong>mechanical reference</strong>: {{ reference_gloss }}. The council may move a few lines; then the risk engine may hold some back. <strong>Size</strong> is how much of a line's full allocation is held (1.00 = the full amount the rules give it); the percentage is its weight in the portfolio.</p>
{% if run.changed_rows %}
{{ m.wrap_open("What changed, by line") }}
<table class="wide stack changes" role="table">
  <thead><tr role="row"><th role="columnheader">Line</th>{% if not cv.rehearsal %}<th role="columnheader" class="n">Before</th>{% endif %}<th role="columnheader" class="n">Reference</th><th role="columnheader" class="n">Council</th><th role="columnheader" class="n">After risk</th><th role="columnheader">Why</th></tr></thead>
  <tbody>
  {% for r in run.changed_rows %}
  <tr role="row">
    <td role="cell"><strong>{{ r.name }}</strong>{% if r.verb %} {{ m.direction_chip(r.verb.split(" ")[0]) }}{% endif %}</td>
    {% if not cv.rehearsal %}<td role="cell" class="n" data-label="Before">{{ r.base_x | share }}</td>{% endif %}
    <td role="cell" class="n" data-label="Reference">size {{ r.ref_level | level }}<br><span class="muted">{{ r.ref_x | share }}</span></td>
    <td role="cell" class="n" data-label="Council"><strong>size {{ r.council_level | level }}</strong><br><span class="muted">{{ r.council_x | share }}</span></td>
    <td role="cell" class="n" data-label="After risk"><strong>size {{ r.risk_level | level }}</strong><br><span class="muted">{{ r.final_x | share }}</span></td>
    <td role="cell" class="text" data-label="Why">{% for w in r.why %}<p class="why"><span class="who">{{ w.who }}:</span> {% if w.raw %}<span title="{{ w.raw }}">{{ w.text }}</span>{% else %}{{ w.text }}{% endif %} {% for e in w.evidence %}{{ m.ev_chip(tr.fx.chip(e)) }}{% endfor %}</p>{% else %}<span class="muted">—</span>{% endfor %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}
<p class="big">No line changed: the council held the mechanical reference.</p>
{% endif %}
{% if run.ref_trades %}
<p>Also traded to reach the reference: <strong>{{ run.ref_trades | map(attribute="words") | join(", ") }}</strong>. No agent asked for {{ "this order" if run.ref_trades | length == 1 else "these orders" }}: the line{{ "s were" if run.ref_trades | length != 1 else " was" }} away from {{ "their" if run.ref_trades | length != 1 else "its" }} reference weight (<a href="#a-costs">the plan</a> says why).</p>
{% endif %}
{% if run.steady %}
<p class="muted">{{ run.steady | length }} line{{ "s" if run.steady | length != 1 }} stayed at the reference: {{ run.steady | map(attribute="name") | join(", ") }}.</p>
{% endif %}
{% if run.general_holds %}<p class="small">Risk engine notes: {% for h in run.general_holds %}<span title="{{ h.raw }}">{{ h.text }}</span>{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
{% endcall %}

{# ---- the code officers: one card, one compact row each (in full when something needs attention) #}
{% set officers = tr.agents | selectattr("group", "equalto", "Code officers") | list %}
{% if officers %}
{% set ns.n = ns.n + 1 %}
<section class="card agent accent-code" id="officers" aria-labelledby="officers-h">
<header class="ahead">
  {{ m.avatar("cpu", "code") }}
  <div class="ahead-text">
    <h2 id="officers-h"><span class="num" aria-hidden="true">{{ ns.n }}</span><span class="h-name">Code officers</span> <span class="node-kind kind-code">CODE</span></h2>
    <p class="job">Code that reads the data, sets the reference and flags shocks and events before any model speaks. Each officer's page says what it reads.</p>
  </div>
  <a class="to-toc" href="#toc">↑ Contents</a>
</header>
{% for a in officers %}
<article class="officer{% if not a.compact %} officer-open{% endif %}" id="{{ a.id }}" aria-labelledby="{{ a.id }}-h">
  <div class="officer-head">
    {{ m.avatar(a.icon, a.accent, "sm") }}
    <h3 class="officer-name" id="{{ a.id }}-h">{{ a.name }}</h3>
    {{ m.mark(a.status) }}
    <p class="officer-result">{{ a.result | cap }}. <a class="small" href="../{{ a.page }}">Its record →</a></p>
  </div>
  {{ officer_body(a) }}
</article>
{% endfor %}
</section>
{% endif %}

{% for a in tr.agents if a.group != "Code officers" %}
{% set ns.n = ns.n + 1 %}
<section class="card agent accent-{{ a.accent }}" id="{{ a.id }}" aria-labelledby="{{ a.id }}-h">
{{ agent_head(a) }}
{% set b = a.body %}

{% if a.slug == "news" %}
{{ subhead("saw", "What it saw") }}
<p>{% if b.n_items %}{{ plural(b.n_items, "broker news item") }}{% else %}The broker news items of the pack{% endif %} — cited by id only; their licensed text is never republished — and the code cards.</p>
{{ subhead("said", "What it said") }}
{% for k in b.cards %}{{ m.kcard(k) }}{% else %}<p class="muted">No cards{% if a.failure %}: the call gave no usable output{% endif %}.</p>{% endfor %}
{% if b.cards %}
{{ subhead("then", "What happened to it") }}
<p>{% if b.qualifying %}{{ plural(b.qualifying | length, "card") }} qualified a cut in an uptrend.{% else %}No card qualified a cut.{% endif %} Who cited each card is listed under it.</p>
{% endif %}

{% elif a.slug == "macro" %}
{{ subhead("saw", "What it saw") }}
<p>{% if b.fx_count %}{{ plural(b.fx_count, "macro series", "macro series") }} from FRED{% else %}Macro series from FRED{% endif %} (values shown only for publishable series) and the calendar.</p>
{% if b.note %}<p class="note-plain">{{ b.note }}</p>{% endif %}
{% if b.macro or b.cards %}
{{ subhead("said", "What it said") }}
{% if b.macro %}
<p>Regime: <span class="chip chip-lg state-{{ b.macro.css }}">{{ b.macro.regime }}</span></p>
{% if b.macro.drivers %}<ol class="claims">{% for d in b.macro.drivers %}<li class="claim">{{ d.text }}{% if d.chips %}<span class="evs">{{ m.chips(d.chips) }}</span>{% endif %}</li>{% endfor %}</ol>{% endif %}
{% if b.macro.tilts %}<p class="small">Tilt by sleeve: {% for t in b.macro.tilts %}<span class="chip state-stone">{{ t.sleeve }}: {{ t.words }}</span> {% endfor %}</p>{% endif %}
{% endif %}
{% for k in b.cards %}{{ m.kcard(k) }}{% endfor %}
{{ subhead("then", "What happened to it") }}
<p>Context only: code never acts on the regime or the tilts. The advocates and the manager may cite its cards.</p>
{% endif %}

{% elif a.slug in ("bull", "bear") %}
{{ advocate(a) }}

{% elif a.slug == "pm" %}
{{ subhead("saw", "What it saw") }}
<p>The whole debate — <a href="#a-bull">the bull's opening</a>, <a href="#a-bear">the bear's answer</a>, <a href="#a-rebuttal">the bull's rebuttal</a> — the {{ plural(b.cards | length, "card") }} and each line's allowed range. Each attempt may change at most {{ max_deviations }} lines.</p>
{{ subhead("said", "What it said") }}
{% if b.reps %}
<p>Valid attempts: <span class="n">{{ b.valid }}</span> of {{ b.total }}.{% if b.pm_same %} {{ b.pm_lead }}{% endif %}</p>
{{ m.reps(b.reps) }}
{% else %}
{{ m.empty("No manager output", "The council did not run or no attempt returned a valid decision; the reference book applies.") }}
{% endif %}
{{ subhead("then", "What happened to it") }}
<p>{% if b.decision %}The used attempt's decision went to the risk engine: <strong>{{ b.decision }}</strong>.{% elif b.reps %}The decision that went to the risk engine: <strong>hold the reference</strong>.{% else %}Every line fell back to the mechanical reference.{% endif %}{% if b.basis and c.basis != "council" %} Basis: {{ b.basis }}.{% endif %}</p>
{% if b.agreement %}
<ul class="agree">{% for x in b.agreement %}<li><strong>{{ x.name }}</strong>: {{ x.words }}{% if " of " in x.words %} attempts{% else %} of attempts{% endif %} made the same call ({{ x.call }})</li>{% endfor %}</ul>
{% if b.agreement_rest %}<p class="small muted">The other {{ b.agreement_rest }} lines: every valid attempt made the same call.</p>{% endif %}
{% endif %}
<p class="small muted">A call is up, hold or down for a line. A line whose used call no other valid attempt shares falls back to the reference.</p>

{% elif a.slug == "control" %}
{{ subhead("saw", "What it saw") }}
<p>The same fact pack and the code cards only: no analysts' cards and no debate.</p>
{% if b.present %}
{% if b.agrees %}
{{ subhead("then", "How it compares with the council") }}
{{ m.control_strip(b.control) }}
<details class="more">
  <summary>Its {{ plural(b.total, "attempt") }} ({{ b.valid }} valid)</summary>
  {{ m.reps(b.reps) }}
</details>
{% else %}
{{ subhead("said", "What it said") }}
<p>Valid attempts: <span class="n">{{ b.valid }}</span> of {{ b.total }}.</p>
{{ m.reps(b.reps) }}
{{ subhead("then", "How it differs from the council") }}
{{ m.control_strip(b.control) }}
{% if b.differs %}
{{ m.wrap_open("Council and control, where they differ") }}
<table class="cmp">
  <thead><tr><th>Line</th><th class="n">Council</th><th class="n">Control</th></tr></thead>
  <tbody>{% for d in b.differs %}<tr><td><strong>{{ d.name }}</strong></td><td class="n">{{ d.council_w }} <span class="muted small">size {{ d.council }}</span></td><td class="n">{{ d.control_w }} <span class="muted small">size {{ d.control }}</span></td></tr>{% endfor %}</tbody>
</table>
</div>
{% endif %}
{% endif %}
{% else %}
<p class="muted">The control did not run this time.</p>
{% endif %}

{% elif a.slug == "audit" %}
{{ subhead("saw", "What it saw") }}
<p>Every manager attempt, the fact pack's ids and each line's allowed range, set by code from its trend.</p>
{{ subhead("did", "What it did") }}
{% if b.notes %}<ul class="ticks">{% for x in b.notes %}<li><a href="#a-pm-{{ x.n }}">Attempt {{ x.n }}</a> {{ x.kind }}: <span title="{{ x.raw }}">{{ x.text }}</span></li>{% endfor %}</ul>{% else %}<p>No attempt cited missing evidence or broke a rule: nothing reverted.</p>{% endif %}
{% if b.clipped %}<p>Clipped into the allowed range: {% for x in b.clipped %}<strong>{{ x.name }}</strong> asked for size {{ x.asked }}, got {{ x.got }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
<p class="small">{{ b.open }} of {{ b.bands | length }} lines had room to move this run; the others were fixed at the reference.</p>
<details class="more">
  <summary>Allowed range of every line ({{ b.bands | length }})</summary>
  {{ m.wrap_open("Allowed ranges (scrolls sideways)") }}
  <table class="wide">
    <thead><tr><th>Line</th><th>Trend</th><th class="n">Reference</th><th class="n">Allowed sizes</th><th>Why</th></tr></thead>
    <tbody>
    {% for r in b.bands %}<tr{% if r.clipped %} class="chosen"{% endif %}><td><strong>{{ r.name }}</strong> <span class="muted small">{{ r.ticker }}</span></td><td>{{ m.trend_chip(r.trend) }}</td><td class="n">{{ r.ref }}</td><td class="n">{{ r.range }}</td><td class="small">{{ r.reasons or "—" }}{% if r.qualifying %} · qualifying: {% for q in r.qualifying %}<a href="{{ tr.fx.href(q) }}">{{ id_label(q).label }}</a>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
</details>

{% elif a.slug == "risk" %}
{{ subhead("saw", "What it saw") }}
<p>The council's levels after the auditor, the book the run started from, and every limit in <a href="../rules.html">the rules</a>.</p>
{{ subhead("did", "What it did") }}
{% if c.risk %}
<p class="big">{% if run.checks_passed == run.checks_total %}{{ m.mark({"css": "ok", "glyph": "✓", "word": "passed"}) }} {{ run.checks_passed }} of {{ run.checks_total }} checks{% else %}{{ m.mark({"css": "fallback", "glyph": "!", "word": "limits applied"}) }} {{ run.checks_passed }} of {{ run.checks_total }} checks passed{% endif %}</p>
{% if run.failed_checks %}
{{ m.wrap_open("Failed checks") }}
<table class="wide">
  <thead><tr><th>Rule</th><th>Check</th><th>Result</th><th class="n">Value</th><th class="n">Limit</th></tr></thead>
  <tbody>
  {% for ch in run.failed_checks %}
  <tr><td class="n">{{ ch.rule_id }}</td><td>{{ check_name(ch.name) }}</td><td><span class="chip state-halted"><span aria-hidden="true">✗ </span>FAIL</span></td><td class="n">{{ ch.value | value }}</td><td class="n">{{ ch.limit | value }}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if b.held %}<p>Held back: {% for r in b.held %}<strong>{{ r.name }}</strong> (<span title="{{ r.held_raw | join('; ') }}">{{ r.held | join("; ") }}</span>){% if not loop.last %}, {% endif %}{% endfor %}.</p>{% else %}<p>Nothing held back.</p>{% endif %}
<dl class="facts facts-plain">
  <div><dt>Invested</dt><dd class="n">{{ run.gross | share }} <span class="muted small">{{ run.gross | x }}</span></dd></div>
  <div><dt>Net</dt><dd class="n">{{ run.net | share }} <span class="muted small">{{ run.net | x }}</span></dd></div>
  <div><dt>Margin use</dt><dd class="n">{{ c.risk.margin_use_pct | pct1 }}</dd></div>
  <div><dt>Expected yearly swings</dt><dd class="n">{{ c.risk.ex_ante_vol_pct | pct1 }}</dd></div>
  <div><dt>Loss if every stop hits</dt><dd class="n">{{ c.risk.stop_at_risk_pct | pct1 }}</dd></div>
  <div><dt>Overnight cost/day</dt><dd class="n">{{ c.risk.carry_bp_day | bp }} <span class="muted small">(1 bp = 0.01%)</span></dd></div>
</dl>
<details class="more">
  <summary>All {{ run.checks_total }} checks</summary>
  {{ m.wrap_open("All risk checks (scrolls sideways)") }}
  <table class="wide">
    <thead><tr><th>Rule</th><th>Check</th><th>Result</th><th class="n">Value</th><th class="n">Limit</th></tr></thead>
    <tbody>
    {% for ch in c.risk.checks %}
    <tr><td class="n">{{ ch.rule_id }}</td><td>{{ check_name(ch.name) }} <span class="muted small">{{ ch.name }}</span></td><td>{% if ch.passed %}<span class="chip state-executed"><span aria-hidden="true">✓ </span>PASS</span>{% else %}<span class="chip state-halted"><span aria-hidden="true">✗ </span>FAIL</span>{% endif %}</td><td class="n">{{ ch.value | value }}</td><td class="n">{{ ch.limit | value }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  </div>
  <p class="small muted">Rule numbers refer to the <a href="../rules.html">rules page</a>. Values are as the risk engine computed them (x = a multiple of the portfolio's value; bp = hundredths of a percent).{% if c.risk.hold_reasons %} Raw hold notes: {% for h in c.risk.hold_reasons %}<code>{{ h }}</code>{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}</p>
</details>
{% else %}
{{ m.empty("No risk decision", "The run ended before the risk engine ran.") }}
{% endif %}

{% elif a.slug == "costs" %}
{{ subhead("saw", "What it saw") }}
<p>The book the run started from, the weights the risk engine allowed and each vehicle's costs.</p>
{{ subhead("did", "What it did") }}
{% if b.legs %}
{% if cv.rehearsal %}<p class="small"><strong>Rehearsal:</strong> these orders were never sent.</p>{% endif %}
{{ m.wrap_open("Orders (scrolls sideways)") }}
<table class="wide rt rt-legs">
  <thead><tr><th>#</th><th>Order</th><th>Line</th><th class="n">Before → after</th><th>Vehicle</th><th class="n">Stop</th><th class="n">Cost</th><th>Why</th></tr></thead>
  <tbody>
  {% for x in b.legs %}{% set leg = x.leg %}
  <tr>
    <td class="n">{{ leg.seq }}</td>
    <td>{{ leg.kind | replace("_", " ") }} {{ m.direction_chip(leg.direction) }}{% if leg.risk_increasing %} <span class="chip state-stone">adds risk</span>{% endif %}</td>
    <td><strong>{{ leg.line | line_name }}</strong></td>
    <td class="n" data-label="Weight">{{ leg.weight_before_x | share }} → {{ leg.weight_after_x | share }}</td>
    <td data-label="Vehicle">{{ leg.settlement or "—" }} · {{ leg.leverage }}x</td>
    <td class="n" data-label="Stop">{{ leg.stop_distance_pct | pct1 }}</td>
    <td class="n" data-label="Cost">{{ leg.cost_bp | bp }}</td>
    <td class="small why-cell">{{ x.why }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p>Total cost <span class="n">{{ c.plan.cost_bp_total | bp }}</span> of the portfolio (1 bp = 0.01%) · overnight cost <span class="n">{{ c.plan.carry_bp_day | bp }}</span> a day · invested <span class="n">{{ c.plan.gross_before_x | share }} → {{ c.plan.gross_after_x | share }}</span></p>
{% else %}
<p>{% set dn = run.nodes | selectattr("key", "equalto", "decision") | first %}No orders this run{% if cv.rehearsal and dn.detail %}: {{ dn.detail }}{% elif not cv.rehearsal %}: the book was already within the deadband, or every change was held back{% endif %}.</p>
{% endif %}
{% if b.skipped %}<p class="small muted">Skipped: {% for s in b.skipped %}<span title="{{ s.raw }}">{{ s.text }}</span>{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
{% endif %}
</section>
{% endfor %}

{% set ns.n = ns.n + 1 %}
{% set costs = tr.by_id["a-costs"].body %}
<section class="card agent accent-human" id="a-decision" aria-labelledby="a-decision-h">
<header class="ahead">
  {{ m.avatar("user", "human") }}
  <div class="ahead-text">
    <h2 id="a-decision-h"><span class="num" aria-hidden="true">{{ ns.n }}</span><span class="h-name">Human approval{% if cv.execution %} and execution{% endif %}</span> <span class="node-kind kind-human">HUMAN</span></h2>
    <p class="job">A person approves or rejects every order in a separate operator terminal; nothing trades on its own.</p>
  </div>
  <p class="h-status">{{ m.mark(tr.decision_status) }}</p>
  <a class="to-toc" href="#toc">↑ Contents</a>
</header>
<div class="status-row">{{ m.chip(cv.chip) }}{% if not cv.rehearsal %}<span class="chip state-sealed">human: {{ cv.human_outcome | replace("_", " ") }}</span>{% endif %}</div>
{% if cv.rehearsal %}<p>Rehearsal: no order existed, so no one had to approve anything.</p>{% endif %}
{% if not (c.plan and c.plan.legs) and not cv.rehearsal %}<p>Nothing to trade this run: the book was already within the deadband, or every change was held back.</p>{% endif %}
{% if cv.final_state != c.decision.state %}<p class="small muted">This run was sealed while the decision was {{ c.decision.human_outcome | replace("_", " ") }}; the outcome shown here comes from the {{ "execution record" if cv.execution else "operations log" }}, published after the decision.</p>{% endif %}
{% if cv.decision_reason %}<p>Reason given: {{ cv.decision_reason }}</p>{% endif %}
{% if cv.approved_slot %}<p class="small">Approved during the slot starting {{ cv.approved_slot | when }} (times are rounded to the slot).</p>{% endif %}
{% if cv.execution %}
{% set ex = cv.execution %}
<h3 id="a-execution">Execution</h3>
{% if ex.fills %}
{{ m.wrap_open("Fills (scrolls sideways)") }}
<table class="wide rt rt-fills">
  <thead><tr><th>#</th><th>Order</th><th>Line</th><th>State</th><th class="n">Target</th><th class="n">Filled</th><th class="n">Slippage</th><th class="n">Cost</th><th>Why</th></tr></thead>
  <tbody>
  {% for f in ex.fills %}
  <tr>
    <td class="n">{{ f.seq }}</td>
    <td>{{ f.kind | replace("_", " ") }}{% if f.direction %} {{ m.direction_chip(f.direction) }}{% endif %}{% if f.leverage and f.leverage > 1 %} <span class="lev">{{ f.leverage }}x</span>{% endif %}{% if f.settlement %} <span class="muted small">{{ f.settlement }}</span>{% endif %}</td>
    <td><strong>{{ f.line | line_name }}</strong></td>
    <td>{% if f.state == "filled" %}<span class="chip state-executed"><span aria-hidden="true">✓ </span>{{ f.state }}</span>{% else %}<span class="chip state-warn"><span aria-hidden="true">! </span>{{ f.state | replace("_", " ") }}</span>{% endif %}</td>
    <td class="n" data-label="Target">{{ f.weight_target_x | x }}</td>
    <td class="n" data-label="Filled">{{ f.weight_filled_x | x }}</td>
    <td class="n" data-label="Slippage">{{ f.slippage_bp | bp }}</td>
    <td class="n" data-label="Cost">{{ f.cost_bp | bp }}</td>
    <td class="small why-cell">{{ costs.why_leg.get(f.seq, "—") }}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% else %}<p class="muted">No order was sent.</p>{% endif %}
<dl class="facts facts-plain">
  <div><dt>Drift after</dt><dd class="n">{{ ex.achieved_drift_x | x }}</dd></div>
  <div><dt>Cost (estimated)</dt><dd class="n">{{ ex.cost_bp_total | bp }}</dd></div>
  <div><dt>Completed</dt><dd class="n">{{ ex.completed_slot | when }}</dd></div>
</dl>
{% if ex.flags %}<p class="small">Flags: {% for f in ex.flags %}<code>{{ f }}</code> {% endfor %}</p>{% endif %}
{% endif %}
</section>

{% set ns.n = ns.n + 1 %}
{% call m.section("facts", ns.n, "Facts the council saw", "neutral") %}
{% set fa = tr.facts %}
{% if fa.total %}
<p>The fact pack of this run: <strong>{{ plural(fa.total, "fact") }}</strong>, each available before the slot started. Values are shown where the <a href="{{ repo_url }}/blob/main/docs/data-rights.md">data rights</a> allow it{% if fa.withheld %}; {{ fa.withheld }} {{ "is" if fa.withheld == 1 else "are" }} named without a value{% endif %}. Every evidence chip on this page links to its row here.</p>
{% if fa.cited %}
<h3>Cited by an agent ({{ fa.cited | length }})</h3>
{{ m.wrap_open("Facts cited this run (scrolls sideways)") }}
<table class="wide facts-table rt rt-facts">
  <thead><tr><th>Fact</th><th>Line</th><th class="n">Value</th><th>Source</th><th>Available</th><th>Cited by</th></tr></thead>
  <tbody>
  {% for f in fa.cited %}
  <tr id="{{ f.anchor }}"><td><span title="{{ f.id }}">{{ f.label }}</span></td><td{% if not f.line %} class="no-line"{% endif %}>{% if f.line %}{{ f.line }} <span class="muted small">{{ f.ticker }}</span>{% else %}—{% endif %}</td><td class="n">{% if f.value %}<strong>{{ f.value }}</strong>{% elif f.withheld %}<span class="muted small">{{ f.withheld }}</span>{% else %}<span class="muted small">id only</span>{% endif %}</td><td class="small">{{ f.source }}</td><td class="small n">{{ f.as_of or "—" }}</td><td class="small">{% for w in f.cited_by %}<a href="{{ w.href }}">{{ w.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
{% endif %}
{% if fa.rest %}
<details class="more">
  <summary>The rest of the pack ({{ fa.total - fa.cited | length }} facts no agent cited)</summary>
  {% for heading, rows in fa.rest %}
  <h4>{{ heading }} <span class="muted small">{{ rows | length }}</span></h4>
  {{ m.wrap_open(heading ~ " (scrolls sideways)") }}
  <table class="wide facts-table rt rt-facts">
    <thead><tr><th>Fact</th><th>Line</th><th class="n">Value</th><th>Source</th><th>Available</th></tr></thead>
    <tbody>
    {% for f in rows %}<tr id="{{ f.anchor }}"><td><span title="{{ f.id }}">{{ f.label }}</span></td><td{% if not f.line %} class="no-line"{% endif %}>{% if f.line %}{{ f.line }}{% else %}—{% endif %}</td><td class="n">{% if f.value %}{{ f.value }}{% elif f.withheld %}<span class="muted small">{{ f.withheld }}</span>{% else %}<span class="muted small">id only</span>{% endif %}</td><td class="small">{{ f.source }}</td><td class="small n">{{ f.as_of or "—" }}</td></tr>{% endfor %}
    </tbody>
  </table>
  </div>
  {% endfor %}
</details>
{% endif %}
{% else %}
<p class="muted">This run was published before the facts table was part of the record: evidence is shown by name, without values.</p>
{% endif %}
{% endcall %}

{% set ns.n = ns.n + 1 %}
{% call m.section("seal", ns.n, "Seal and call log", "neutral") %}
<p>A hash of this run was published before any order could be approved; this file and the salt that opens the seal came later. {% if cv.verified %}{{ m.mark({"css": "ok", "glyph": "✓", "word": "verified here"}) }}{% else %}{{ m.mark({"css": "fallback", "glyph": "!", "word": "not verified here"}) }}{% endif %}</p>
<dl class="facts facts-plain">
  <div><dt>Commitment</dt><dd class="n">{% if cv.commitment %}{{ cv.commitment.commitment_sha256 | sha }}{% else %}—{% endif %}</dd></div>
  <div><dt>Sealed at</dt><dd class="n">{% if cv.commitment %}{{ cv.commitment.sealed_at | when }}{% else %}—{% endif %}</dd></div>
  <div><dt>Verified here</dt><dd>{{ "yes" if cv.verified else "no" }}</dd></div>
  <div><dt>Input hash</dt><dd class="n">{{ c.input_hash | sha }}</dd></div>
  <div><dt>Policy</dt><dd class="n">{{ c.policy_sha | sha }}</dd></div>
  <div><dt>Prompts</dt><dd class="n">{{ c.prompt_manifest_sha | sha }}</dd></div>
  <div><dt>Material facts</dt><dd class="n">{{ c.material_fingerprint | sha }}</dd></div>
</dl>
<p class="small">Files: <a href="../{{ cv.path }}">cycle</a>{% if cv.reveal %} · <a href="../{{ cv.path | replace('.json', '.reveal.json') }}">salt</a>{% endif %}{% if cv.execution_path %} · <a href="../{{ cv.execution_path }}">execution</a>{% endif %}. Check: sha256(bytes.fromhex(salt) + cycle file bytes) equals the commitment.</p>
{% if tr.calls %}
<h3 id="calls">Every model call, in order ({{ tr.calls | length }})</h3>
{{ m.wrap_open("Model calls (scrolls sideways)") }}
<table class="wide calls rt rt-calls">
  <thead><tr><th>Agent</th><th>Status</th><th>What it means</th><th class="n">Time</th><th class="n">Tokens in / out</th><th>Prompt</th></tr></thead>
  <tbody>
  {% for x in tr.calls %}
  <tr{% if x.failed %} class="failed"{% endif %}><td class="call-agent">{% if x.anchor %}<a href="#{{ x.anchor }}"><span class="dot accent-{{ x.accent }}" aria-hidden="true"></span>{{ x.agent_name }}</a>{% else %}{{ x.agent_name }}{% endif %}{% if x.role in ("pm", "single_agent") %} <span class="muted small">attempt {{ x.replicate }}</span>{% endif %}</td><td>{{ m.mark(x) }}</td><td class="small call-means">{{ x.explain or "—" }}</td><td class="n">{{ x.latency }}</td><td class="n">{{ x.tokens_in }} / {{ x.tokens_out }}</td><td class="call-prompt">{% if x.prompt_href %}<a href="{{ x.prompt_href }}">{{ x.prompt_id }}</a>{% else %}<code>{{ x.prompt_id }}</code>{% endif %} <span class="n muted small">{{ x.prompt_sha }}</span></td></tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="small muted">{{ t.foot }}</p>
{% endif %}
{% if c.flags %}<p class="small">Flags: {% for f in c.flags %}<code>{{ f }}</code> {% endfor %}</p>{% endif %}
{% endcall %}
{% endblock %}
